          "id": "cb9216c5-529b-4b6b-b5a2-3970bf2082f1",
          "name": "Get nearest ASHRAE station by coordinates",
          "request": {
            "name": "Get nearest ASHRAE station by coordinates",
            "description": {
              "content": "### GET /ASHRAE\n\nReturns the closest ASHRAE station based on the specified coordinates. The station with the shortest distance from the latitude and longitude is returned.\n\n**Parameters:**\n- `Latitude` (query, required): Latitude coordinate.\n- `Longitude` (query, required): Longitude coordinate.\n- `Version` (query, optional): ASHRAE version (AshraeVersionEnum). Default: Version_2021.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ASHRAE"
              ],
              "host": [
                "{{ASHRAE-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "Latitude",
                  "value": "<number>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "Longitude",
                  "value": "<number>",
                  "description": "(Required) "
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
