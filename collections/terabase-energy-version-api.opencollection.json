{
  "opencollection": "1.0.0",
  "info": {
    "name": "PlantPredict Version API",
    "version": "current"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Version",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the system version.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Version"
          },
          "docs": "Get the system version."
        }
      ]
    }
  ],
  "bundled": true
}