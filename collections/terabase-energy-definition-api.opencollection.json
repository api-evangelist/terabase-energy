{
  "opencollection": "1.0.0",
  "info": {
    "name": "PlantPredict Definition API",
    "version": "current"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Definition",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the list of all system defined enumeration definitions.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Definitions",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get the list of all system defined enumeration definitions."
        }
      ]
    }
  ],
  "bundled": true
}