{
  "opencollection": "1.0.0",
  "info": {
    "name": "PlantPredict Module API",
    "version": "current"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Module",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a Module by Id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Module/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a Module by Id."
        },
        {
          "info": {
            "name": "Update a Module.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/Module/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Module ID from URL"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This operation may attach a X-Message header on the response carrying an informational message about the updated entity."
        },
        {
          "info": {
            "name": "Delete a Module by Id.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/Module/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a Module by Id."
        },
        {
          "info": {
            "name": "Get a list of Modules to which you have access.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Module"
          },
          "docs": "Get a list of Modules to which you have access."
        },
        {
          "info": {
            "name": "Create a new Module.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/Module",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This operation may attach a X-Message header on the response carrying an informational message about the new entity."
        },
        {
          "info": {
            "name": "Get overview data for all Modules for which you have access.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Module/ModuleOverview"
          },
          "docs": "Get overview data for all Modules for which you have access."
        },
        {
          "info": {
            "name": "Pre-save content-match check (PP-2570). Returns the accessible library record whose\ncontent matches the posted module - selected by status hierarchy Global > Active >\nDraft-Private > Draft-Shared - or null when nothing matches. Name is excluded from\nidentity; Retired records never match. Persists nothing.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/Module/CheckMatch",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Pre-save content-match check (PP-2570). Returns the accessible library record whose\ncontent matches the posted module - selected by status hierarchy Global > Active >\nDraft-Private > Draft-Shared - or null when nothing matches. Name is excluded from\nidentity; Retired records never match. Persists nothing."
        },
        {
          "info": {
            "name": "Get the Notes for a Module by Module Id.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Module/:moduleId/Note",
            "params": [
              {
                "name": "moduleId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the Notes for a Module by Module Id."
        },
        {
          "info": {
            "name": "Delete a Note for a Module by Note Id and Module Id.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/Module/:moduleId/Note/:noteId",
            "params": [
              {
                "name": "moduleId",
                "value": "",
                "type": "path"
              },
              {
                "name": "noteId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a Note for a Module by Note Id and Module Id."
        },
        {
          "info": {
            "name": "Get the default IAM (Incidence Angle Modifier).",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/Module/DefaultIAM",
            "params": [
              {
                "name": "ASHRAEIAM",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "See https://plantpredict.com/algorithm/optical-losses/"
        },
        {
          "info": {
            "name": "Update the Status of a list of Modules by list of Ids.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/Module/Status",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the Status of a list of Modules by list of Ids."
        },
        {
          "info": {
            "name": "Parses the provided IVCurvePoints template and returns the minimum inputs required for the /ProcessIVCurvePoints endpoint.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/Module/Generator/ParseIVCurvePoints",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Parses the provided IVCurvePoints template and returns the minimum inputs required for the /ProcessIVCurvePoints endpoint."
        }
      ]
    }
  ],
  "bundled": true
}