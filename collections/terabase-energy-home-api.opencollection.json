{
  "opencollection": "1.0.0",
  "info": {
    "name": "PlantPredict Home API",
    "version": "current"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Home",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Home - redirects to UI URL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "docs": "Get Home - redirects to UI URL"
        }
      ]
    }
  ],
  "bundled": true
}